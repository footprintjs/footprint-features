{
  "name": "footprint-features",
  "version": "0.1.0",
  "description": "TypeScript module registry and school-profile configuration: dependency resolution, feature gates, terminology, role declarations and seed blueprints.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "typescript",
    "feature-modules",
    "module-registry",
    "dependency-graph",
    "school",
    "configuration",
    "terminology",
    "footprintjs"
  ],
  "author": "footprintjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/footprintjs/footprint-features.git"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/footprintjs/footprint-features#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/footprint-features/issues"
  }
}
